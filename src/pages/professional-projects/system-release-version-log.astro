---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="System Release Version Log" description="System Release Version Log — Hunter Myers">
  <nav class="breadcrumb">
    <a href={`${base}/professional-projects/`}>&larr; Professional Projects</a>
  </nav>

  <section class="section">
    <h1>Project Title</h1>
    <p class="subtitle">Company Name &middot; 20XX – 20XX</p>
  </section>

  <div class="project-body">

    <section class="project-section">
      <h2>The Problem</h2>
      <p>
        Description of the business problem and why it mattered. What was broken, missing,
        or painful? Who was affected and what were the stakes?
      </p>
    </section>

    <section class="project-section">
      <h2>Design Decisions &amp; Tradeoffs</h2>
      <p>
        What options were on the table? What did we choose and why? What did we deliberately
        not do, and what did we accept as a consequence?
      </p>
    </section>

    <section class="project-section">
      <h2>Architecture</h2>
      <div class="diagram-wrapper">
        <img
          src={`${base}/diagrams/system-release-version-log.svg`}
          alt="System Release Version Log architecture diagram"
          class="diagram"
          id="arch-diagram"
        />
        <span class="diagram-hint">Click to enlarge</span>
      </div>
    </section>

    <div id="lightbox" class="lightbox" aria-hidden="true">
      <img
        src={`${base}/diagrams/system-release-version-log.svg`}
        alt="System Release Version Log architecture diagram (full size)"
        class="lightbox-img"
      />
    </div>

    <section class="project-section">
      <h2>Outcome</h2>
      <p>
        What shipped? What changed as a result? Quantifiable impact where possible.
      </p>
    </section>

  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.875rem;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .project-section h2 {
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .project-section p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .diagram-wrapper {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  .diagram {
    max-width: 100%;
    height: auto;
    cursor: zoom-in;
    transition: opacity 0.15s;
  }

  .diagram:hover {
    opacity: 0.85;
  }

  .diagram-hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
    cursor: zoom-out;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }
</style>

<script>
  const diagram = document.getElementById('arch-diagram');
  const lightbox = document.getElementById('lightbox');

  diagram?.addEventListener('click', () => lightbox?.classList.add('open'));
  lightbox?.addEventListener('click', () => lightbox.classList.remove('open'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') lightbox?.classList.remove('open');
  });
</script>
